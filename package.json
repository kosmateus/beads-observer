{
  "name": "@opentoria/beads-observer",
  "version": "0.16.3",
  "type": "module",
  "description": "Beads board, dependency explorer and issue creation for OpenCode",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/src/cli.js",
    "demo": "npm run build && node dist/src/cli.js --demo",
    "build": "tsx scripts/build.ts",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "tsx scripts/check-package.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run pack:check",
    "release": "npm run build && semantic-release",
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/src",
    "dist/web",
    "README.md",
    "opencode.example.json",
    "LICENSE"
  ],
  "peerDependencies": {
    "@opencode/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "license": "MIT",
  "bin": {
    "beads-observer": "dist/src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosmateus/beads-observer.git"
  },
  "homepage": "https://github.com/kosmateus/beads-observer#readme",
  "bugs": {
    "url": "https://github.com/kosmateus/beads-observer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "beads",
    "opencode",
    "dashboard",
    "issues",
    "agents"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opencode/plugin": "2.2.7",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "22.20.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.13.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "lint-staged": {
    "*.{json,jsonc,yml,yaml,md,css,html}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
